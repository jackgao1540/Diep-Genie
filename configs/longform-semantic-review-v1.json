{
  "schema_version": 1,
  "review": "runs/longform-semantic-coverage-v1",
  "index_sha256": "cafff70b9df7801c937622a0485ad7891a5fb88d26c8fe4e15d2f40fda8c9f03",
  "reviewer": "Codex visual review",
  "method": "Inspected all 24 original-crop storyboards: 96 blocks, eight sampled frames per block (768 images). These are exploratory semantic observations, not exhaustive four-second action labels, a new all-frame quality audit, or renewed class approval.",
  "definitions": {
    "player_palette": "Visible center/player body palette; recoloring and source effects are not distinguished from game team colors.",
    "barrel_layout": "Visually single, multiple, or uncertain barrel geometry; not an exact tank-class label.",
    "maze_wall": "Outlined solid gray maze obstacle visible. Arena edges, team-base shading, and dominator zones do not count.",
    "yellow_square": "At least one ordinary yellow square food object visible; mass necromancer square drones do not count.",
    "red_triangle": "At least one ordinary red/pink triangular food object visible; controlled drones and traps do not count.",
    "blue_pentagon": "At least one blue/purple pentagon food object visible; dominators do not count.",
    "large_blue_pentagon": "A food pentagon visibly at least approximately twice the player body diameter; overlaps blue_pentagon.",
    "aim_change": "Clear substantial change in visible player barrel orientation between displayed frames; small jitter is not counted. Symmetric geometry can remain uncertain. Does not identify mouse input.",
    "player_firing_evidence": "An outward projectile stream or muzzle-adjacent emission attributable to the player is visible; isolated nearby bullets from other players do not suffice. not_seen does not prove no firing between frames.",
    "scene_translation": "Clear translation of visible food, walls, arena/base boundaries relative to the tracked player across displayed frames. This is scene/camera motion, not verified tank displacement. Empty or ambiguous scenes remain uncertain; not_seen is not a stationary-action label.",
    "ten_plus_projectiles": "At least one displayed crop visibly contains ten or more circular bullet projectiles; does not count drones/traps. Descriptive projectile density, not enemy count or combat difficulty."
  },
  "value_policy": "For observation fields: seen, not_seen, uncertain. not_seen refers only to displayed frames. Multiple tags can overlap; sample counts cannot be summed as unique duration.",
  "test_pixels_reviewed": false,
  "training_approved": false,
  "notes": [
    {
      "review_index": 57,
      "note": "Small diep.io text at lower crop edge resolved in full original frame detail-057.png: native name above another tank just below crop. Not corner HUD or added caption; retained."
    }
  ],
